; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="SIGNAL LOST"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameConfig="*res://autoload/game_config.gd"
Palette="*res://autoload/palette_service.gd"
NoiseBus="*res://autoload/noise_bus.gd"
PulseRegistry="*res://autoload/pulse_registry.gd"
GameState="*res://autoload/game_state.gd"
AudioManager="*res://autoload/audio_manager.gd"
SceneRouter="*res://autoload/scene_router.gd"
SaveData="*res://autoload/save_data.gd"
DebugFlags="*res://autoload/debug_flags.gd"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://resources/theme/ui_theme.tres"


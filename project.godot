config_version=5

[application]

config/name="SIGNAL LOST"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
2d/shadow_atlas/size=2048

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="one_way"
2d_physics/layer_3="player"
2d_physics/layer_4="enemy"
2d_physics/layer_5="interactable"
2d_physics/layer_6="projectile"
2d_physics/layer_7="hazard_kill"
2d_render/layer_1="world_fg"
2d_render/layer_2="world_bg"
2d_render/layer_3="actors"
2d_render/layer_4="air"


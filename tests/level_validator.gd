extends SceneTree

func _init() -> void:
	call_deferred(&"_run_validation")

func _run_validation() -> void:
	await process_frame
	print("--- RUNNING LEVEL VALIDATION ---")

	var ParserScript = load("res://scenes/level/level_parser.gd")
	var ValidatorScript = load("res://scenes/level/level_validator.gd")
	var PlatformGraphScript = load("res://scenes/level/platform_graph.gd")

	var levels: Array[String] = [
		"res://levels/level_01.txt",
		"res://levels/level_02.txt",
		"res://levels/level_03.txt",
		"res://levels/level_04.txt",
		"res://levels/level_05.txt",
		"res://levels/level_06.txt",
		"res://levels/level_07.txt",
		"res://levels/level_08.txt",
		"res://levels/level_09.txt"
	]

	var results: Array[Dictionary] = []
	var markdown_lines: Array[String] = []
	markdown_lines.append("# SIGNAL LOST - LEVEL VALIDATION REPORT")
	markdown_lines.append("**Generated by:** `tests/level_validator.gd`  ")
	markdown_lines.append("**Validation Criteria:**")
	markdown_lines.append("- **Spawn vertical clearance:** >= 3 tiles overhead without solid blocks (`#`)")
	markdown_lines.append("- **Spawn horizontal space:** >= 6 contiguous non-solid tiles around spawn point")
	markdown_lines.append("- **Exit reachability:** Continuous valid path from spawn to exit (max jump height 2.7 tiles, max jump horizontal reach 3 tiles, keycards must unlock doors)")
	markdown_lines.append("- **Memory fragments:** Reported count (spec requires 3 per sector)")
	markdown_lines.append("")
	markdown_lines.append("| Level File | Sector Name | Status | Spawn Vert | Spawn Horiz | Fragments | Exit Reachable | Issues / Details |")
	markdown_lines.append("|---|---|---|---|---|---|---|---|")

	for lvl_path in levels:
		var file_name: String = lvl_path.get_file()
		var data: LevelData = ParserScript.parse_file(lvl_path)
		var res: Dictionary = {
			"file": file_name,
			"name": "",
			"status": "PASS",
			"vert_clear": 0,
			"horiz_clear": 0,
			"fragments": 0,
			"exit_reachable": false,
			"issues": []
		}

		if data == null:
			res["status"] = "FAIL"
			(res["issues"] as Array).append("Failed to parse level file")
			results.append(res)
			markdown_lines.append("| `%s` | Unknown | **FAIL** | 0 | 0 | 0 | No | Failed to parse |" % file_name)
			continue

		res["name"] = data.name
		var p_cells: Array = data.cells.get("P", [])
		var e_cells: Array = data.cells.get("E", [])
		var f_cells: Array = data.cells.get("F", [])
		res["fragments"] = f_cells.size()

		if p_cells.size() != 1:
			res["status"] = "FAIL"
			(res["issues"] as Array).append("Expected 1 player spawn 'P', found %d" % p_cells.size())
		if e_cells.size() != 1:
			res["status"] = "FAIL"
			(res["issues"] as Array).append("Expected 1 exit terminal 'E', found %d" % e_cells.size())

		var vert_clear: int = 0
		var horiz_clear: int = 0

		if p_cells.size() == 1:
			var sp: Vector2i = p_cells[0]
			# Vertical clearance upwards from spawn
			var cy: int = sp.y - 1
			while cy >= 0:
				if data.grid[cy][sp.x] == "#":
					break
				vert_clear += 1
				cy -= 1
			res["vert_clear"] = vert_clear

			# Horizontal clearance at spawn row
			var left_c: int = sp.x
			while left_c >= 0 and data.grid[sp.y][left_c] != "#":
				left_c -= 1
			var right_c: int = sp.x
			while right_c < data.width and data.grid[sp.y][right_c] != "#":
				right_c += 1
			horiz_clear = (right_c - 1) - (left_c + 1) + 1
			res["horiz_clear"] = horiz_clear

			if vert_clear < 3:
				res["status"] = "FAIL"
				(res["issues"] as Array).append("Vertical clearance %d < 3 tiles" % vert_clear)
			if horiz_clear < 6:
				res["status"] = "FAIL"
				(res["issues"] as Array).append("Horizontal clearance %d < 6 tiles" % horiz_clear)

		# Exit & Fragment Reachability check + Validator rules
		if p_cells.size() == 1 and e_cells.size() == 1:
			var val_rep: Dictionary = ValidatorScript.validate(data)
			var errs: Array = val_rep.get("errors", [])
			var reachable: bool = true
			for e in errs:
				var estr: String = str(e)
				if estr.contains("not reachable") or estr.contains("soft-lock") or estr.contains("pocket"):
					reachable = false
				(res["issues"] as Array).append(estr)
			res["exit_reachable"] = reachable
			if not reachable or not errs.is_empty():
				res["status"] = "FAIL"

		results.append(res)
		var issues_str: String = "None"
		if not (res["issues"] as Array).is_empty():
			issues_str = "; ".join(res["issues"])

		var status_badge: String = "**PASS**" if res["status"] == "PASS" else "**FAIL**"
		var reach_str: String = "Yes" if res["exit_reachable"] else "No"
		markdown_lines.append("| `%s` | %s | %s | %d | %d | %d/3 | %s | %s |" % [
			file_name,
			res["name"],
			status_badge,
			res["vert_clear"],
			res["horiz_clear"],
			res["fragments"],
			reach_str,
			issues_str
		])
		print("[%s] %s (%s): Vert=%d, Horiz=%d, Frags=%d, Reachable=%s -> %s" % [
			res["status"],
			file_name,
			res["name"],
			res["vert_clear"],
			res["horiz_clear"],
			res["fragments"],
			reach_str,
			issues_str
		])

	# Write out markdown report
	var full_report: String = "\n".join(markdown_lines) + "\n"
	var out_file := FileAccess.open("res://docs/LEVEL_VALIDATION.md", FileAccess.WRITE)
	if out_file != null:
		out_file.store_string(full_report)
		out_file.close()
		print("Successfully wrote validation report to res://docs/LEVEL_VALIDATION.md")
	else:
		push_error("Failed to write to res://docs/LEVEL_VALIDATION.md")

	quit()
